# Keep this repository limited to the buildable client source.
*

!.gitignore
!README.md
!Run.bat
!s4client.sln
!s4client.vcxproj

!src/
!src/**
src/**/test_*.cpp
src/**/*.dll
src/**/*.ps1
src/**/README*
src/newrender/existing_client_*

!third_party/
third_party/*
!third_party/stb_vorbis.c
!third_party/lua_weapon_shim.lua
!third_party/lua-5.1.5/
third_party/lua-5.1.5/*
!third_party/lua-5.1.5/COPYRIGHT
!third_party/lua-5.1.5/src/
!third_party/lua-5.1.5/src/*.c
!third_party/lua-5.1.5/src/*.h
third_party/lua-5.1.5/src/lua.c
third_party/lua-5.1.5/src/luac.c
third_party/lua-5.1.5/src/print.c

# Explicit local/generated exclusions (also covered by the whitelist above).
resources/
tests/
DOCUMENTATION/
*.md
!README.md
*.obj
*.exe
*.pdb
*.ilk
*.i64
*.rar

# Runnable Release package only. Extracted assets remain excluded.
!build/
build/*
!build/Release/
build/Release/*
!build/Release/S4Client.exe
!build/Release/d3dx9_29.dll
!build/Release/weapon_loadout.json
!build/Release/weapon_bone_overrides.json
!build/Release/third_party/
build/Release/third_party/*
!build/Release/third_party/lua_weapon_shim.lua
